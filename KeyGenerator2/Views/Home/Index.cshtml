@{
  ViewData["Title"] = "JWT Key Generator";
}

<div class="row justify-content-center mt-4">

  <div class="col-12 col-md-5 mb-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h4 class="card-title text-primary mb-4">JWT Key Generator</h4>

        <form id="optionsForm" method="post" asp-controller="Home" asp-action="Create">
          @Html.AntiForgeryToken()

          <p>This site generates a <b>64-byte (512-bit)</b> key that can safely be used for common HMAC algorithms used with <b>JWT (JSON web tokens)</b> such as <b>HMAC-SHA256 (HS256) or HMAC-SHA512 (HS512)</b>.</p>
          <p>It uses a cryptographically strong pseudo-random number generator (CSPRNG).</p>
          
          @* Generate Button *@
          <div class="d-grid gap-2 pt-3">
            <button type="submit" class="btn btn-success btn-lg" id="generateButton">
              <i class="bi bi-key-fill me-2"></i> GENERATE KEY
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>


</div>

